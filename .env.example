# Server-side values, used by npm start and the Vite development proxy.
# FINCHAT_HOST is a hostname (no scheme or path).
FINCHAT_HOST=api.dev.finchat.club
FINCHAT_API_KEY=replace-with-server-side-api-key
PORT=4173
LIVEKIT_URL=wss://call.finchat.club
MAX_FILE_BYTES=52428800
MAX_DOWNLOAD_BYTES=52428800
ALLOWED_ORIGINS=https://app.test.finchat.club

# Optional BUILD-TIME direct browser connection (normally leave unset).
# All VITE_* values are PUBLIC and embedded in dist. Never put secrets here.
# VITE_FINCHAT_HOST=api.dev.finchat.club
# VITE_FINCHAT_API_KEY=replace-with-public-browser-api-key
