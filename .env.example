# Values used by npm start, the Vite development proxy, and browser build fallbacks.
# FINCHAT_HOST is a hostname (no scheme or path).
FINCHAT_HOST=api.dev.finchat.club
FINCHAT_API_KEY=replace-with-finchat-application-api-key
PORT=4173
LIVEKIT_URL=wss://call.finchat.club
MAX_FILE_BYTES=52428800
MAX_DOWNLOAD_BYTES=52428800
ALLOWED_ORIGINS=https://app.test.finchat.club

# Optional BUILD-TIME overrides for the browser connection.
# Browser host/key default to FINCHAT_HOST/FINCHAT_API_KEY, as in earlier builds.
# The selected API key is PUBLIC in dist; use only the FinChat application key.
# VITE_FINCHAT_HOST=api.dev.finchat.club
# VITE_FINCHAT_API_KEY=replace-with-public-browser-api-key
